# Makefile for Python C++ binding using pybind11

CXX = g++
PYTHON = python3
PYBIND11_INCLUDES = $(shell $(PYTHON) -m pybind11 --includes)
PYTHON_SUFFIX = $(shell $(PYTHON)-config --extension-suffix)

# Compiler flags
CXXFLAGS = -std=c++20 -O3 -march=native -mtune=native -flto
CXXFLAGS += -Wall -Wextra -Wno-unused-parameter
CXXFLAGS += -pthread -fPIC -shared
CXXFLAGS += -DNDEBUG -ffast-math
CXXFLAGS += -funroll-loops -finline-functions
CXXFLAGS += -falign-functions=64 -falign-loops=64

# Includes
CXXFLAGS += $(PYBIND11_INCLUDES)

# Link flags
LDFLAGS = -flto -pthread
LIBS = -lm

# Target module
TARGET = rowing_cpp.so

# Source files
SOURCES = rowing_cpp_binding.cpp keypoint_recorder.cpp phase_controller.cpp
OBJECTS = $(SOURCES:.cpp=.o)

# Default target
all: $(TARGET)

$(TARGET): $(SOURCES) keypoint_recorder.hpp phase_controller.hpp
	@echo "Building Python module: $(TARGET)"
	$(CXX) $(CXXFLAGS) $(SOURCES) -o $(TARGET) $(LDFLAGS) $(LIBS)
	@echo "Build complete!"
	@echo ""
	@echo "To test:"
	@echo "  python3 -c 'import rowing_cpp; print(rowing_cpp.__doc__)'"

.PHONY: clean install test
clean:
	rm -f $(TARGET) $(OBJECTS)
	rm -f *.so *.dylib
	@echo "Clean complete"

install: $(TARGET)
	cp $(TARGET) ../../  # Copy to SDK root for import
	@echo "Installed to SDK root directory"

test: $(TARGET)
	@echo "Running quick module test..."
	python3 -c "import rowing_cpp; print('✓ Module loaded successfully')"
	python3 -c "import rowing_cpp; rec = rowing_cpp.KeypointRecorder(30, '/tmp/test'); print('✓ KeypointRecorder created')"
	@echo "All tests passed!"
